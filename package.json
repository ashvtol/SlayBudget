{
  "name": "slaybudget",
  "private": true,
  "version": "0.10.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check": "cargo test -p slaybudget-core && cargo clippy -p slaybudget-core -- -D warnings && cargo fmt --check && npm run typecheck && npm run lint && npm test",
    "tauri": "tauri",
    "release": "node scripts/release.ts",
    "publish:github": "node scripts/publish.ts",
    "release:rehearse": "node scripts/rehearse.ts",
    "release:approve": "node scripts/approve.ts",
    "release:cleanup": "node scripts/cleanup.ts",
    "fx:rates": "node scripts/fx-rates.ts"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@visx/gradient": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/hierarchy": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "d3-hierarchy": "^3.1.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "description": "Free, open-source, local-first budgeting app for Mac: import bank statements, auto-categorize spending, budgets, recurring bills. A private Copilot Money / YNAB alternative.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashvtol/SlayBudget.git"
  },
  "homepage": "https://github.com/ashvtol/SlayBudget#readme",
  "keywords": [
    "budget",
    "budgeting-app",
    "personal-finance",
    "expense-tracker",
    "money-manager",
    "macos",
    "tauri",
    "rust",
    "react",
    "local-first",
    "privacy",
    "sqlite",
    "copilot-money-alternative",
    "ynab-alternative",
    "mint-alternative"
  ]
}
